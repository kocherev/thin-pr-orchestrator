{
  "name": "thin-pr-orchestrator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && node --experimental-strip-types scripts/check-core-boundary.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "eval": "node --disable-warning=ExperimentalWarning --import tsx scripts/eval.ts",
    "eval:judge": "node --disable-warning=ExperimentalWarning --import tsx scripts/judge.ts",
    "trace": "node --disable-warning=ExperimentalWarning --import tsx scripts/trace.ts",
    "build": "tsc -b --pretty false"
  },
  "dependencies": {
    "@thin-pr/core": "workspace:*",
    "@thin-pr/gate": "workspace:*",
    "@thin-pr/github": "workspace:*",
    "@thin-pr/specialists": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
