{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thin-pr-app",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "Runner",
      "image": "./runner/Dockerfile",
      // The runner image builds the whole monorepo, so the context is the repo root.
      "image_build_context": "../..",
      "instance_type": "standard-2",
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RUNNER",
        "class_name": "Runner"
      }
    ]
  },
  "exports": {
    "Runner": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "pr-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "pr-jobs",
        "max_batch_size": 1,
        "max_retries": 2,
        "dead_letter_queue": "pr-jobs-dlq"
      }
    ]
  },
  "vars": {
    "THIN_PR_MODEL": "live",
    "THIN_PR_SPEND_LIMIT_USD": "25",
    // Optional. An OTLP endpoint on port 443 turns on traces for App runs. See docs/deploy.md.
    "OTEL_EXPORTER_OTLP_ENDPOINT": ""
  },
  "secrets": {
    "required": [
      "GITHUB_WEBHOOK_SECRET",
      "GITHUB_APP_CLIENT_ID",
      "GITHUB_APP_PRIVATE_KEY",
      "ANTHROPIC_API_KEY"
    ]
  }
}
