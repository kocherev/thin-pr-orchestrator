    "patch": "diff --git a/src/format.ts b/src/format.ts\nindex c4cc2f1..3147372 100644\n--- a/src/format.ts\n+++ b/src/format.ts\n@@ -1,3 +1,9 @@\n export function formatCount(value: number): string {\n+  for (const [size, unit] of [[1_000_000, \"M\"], [1000, \"k\"]] as const) {\n+    const scaled = Number((value / size).toFixed(1));\n+    if (Math.abs(value) >= 1000 && Math.abs(scaled) >= 1) {\n+      return `${scaled}${unit}`;\n+    }\n+  }\n   return String(value);\n }\ndiff --git a/test/format.test.ts b/test/format.test.ts\nindex fadddd1..60f7fa5 100644\n--- a/test/format.test.ts\n+++ b/test/format.test.ts\n@@ -4,3 +4,8 @@ import { formatCount } from \"../src/format.js\";\n it(\"renders a small count as digits\", () => {\n   expect(formatCount(42)).toBe(\"42\");\n });\n+\n+it(\"renders large counts in compact form\", () => {\n+  expect(formatCount(1240)).toBe(\"1.2k\");\n+  expect(formatCount(3_400_000)).toBe(\"3.4M\");\n+});\n"
