+}
+
+test("sign-in returns to a safe next path and the link keeps it", async () => {
+  auth.signIn.mockResolvedValue({ data: { user: { id: "u1" } }, error: null });
+  render(<AuthForm mode="sign-in" next="/products/abc?x=1" />);
+
