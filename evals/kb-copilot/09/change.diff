+  await vi.waitFor(() => expect(auth.replace).toHaveBeenCalledWith("/products/abc?x=1"));
+});
+
+test.each(["//evil.example", "https://evil.example", "/\\evil.example"])(
+  "sign-in ignores the unsafe next %s",
+  async (next) => {
+    auth.signIn.mockResolvedValue({ data: { user: { id: "u1" } }, error: null });
+    render(<AuthForm mode="sign-in" next={next} />);
+
+    expect(screen.getByRole("link", { name: "Create an account" }).getAttribute("href")).toBe(
+      "/sign-up",
+    );
+    signIn();
+
+    await vi.waitFor(() => expect(auth.replace).toHaveBeenCalledWith("/"));
