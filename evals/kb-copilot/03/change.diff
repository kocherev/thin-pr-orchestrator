+def leave_creating(sync_engine: Engine, id: str, age: timedelta) -> None:
+    """Leave the row as an approve that died after its claim would."""
+    with Session(sync_engine) as db:
+        db.execute(
+            update(EscalationRow)
+            .where(EscalationRow.id == UUID(id))
+            .values(status="creating", updated_at=utcnow() - age)
+        )
+        db.commit()
+
+
+def test_a_stuck_creating_escalation_is_reclaimed_once(
+    http: TestClient,
+    linear: FakeLinear,
+    room: str,
+    as_user: Headers,
+    sync_engine: Engine,
+    rows,
+) -> None:
+    connect(http, as_user())
+    escalation = propose(http, room).json()
+    leave_creating(sync_engine, escalation["id"], timedelta(minutes=3))
+    url = f"/escalations/{escalation['id']}/approve"
+
+    first = http.post(url, headers=as_user())
+    second = http.post(url, headers=as_user())
+
+    assert first.status_code == second.status_code == 200
+    assert first.json()["status"] == "created"
+    assert first.json()["issue_identifier"] == "ENG-1"
+    assert second.json() == first.json()
+    assert len(linear.issues) == 1
+    assert rows("escalations")[0]["status"] == "created"
+
+
