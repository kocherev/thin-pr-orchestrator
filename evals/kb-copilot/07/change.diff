diff --git a/apps/web/src/lib/public-url.test.ts b/apps/web/src/lib/public-url.test.ts
new file mode 100644
index 0000000..3b74afc
--- /dev/null
+++ b/apps/web/src/lib/public-url.test.ts
@@ -0,0 +1,24 @@
+import { afterEach, expect, test, vi } from "vitest";
+
+import { publicUrl } from "@/lib/public-url";
+
+const request = { url: "http://0.0.0.0:3000/api/integrations/linear/callback" };
+
+afterEach(() => vi.unstubAllEnvs());
+
+test("BETTER_AUTH_URL is the base when it is set", () => {
+  vi.stubEnv("BETTER_AUTH_URL", "https://app.example.com");
+  expect(publicUrl("/sign-in", request).toString()).toBe("https://app.example.com/sign-in");
+});
+
+test("a trailing slash in BETTER_AUTH_URL does not break the path", () => {
+  vi.stubEnv("BETTER_AUTH_URL", "https://app.example.com/");
+  expect(publicUrl("/settings?linear=connected", request).toString()).toBe(
+    "https://app.example.com/settings?linear=connected",
+  );
+});
+
+test("without BETTER_AUTH_URL the request URL is the base", () => {
+  vi.stubEnv("BETTER_AUTH_URL", undefined);
+  expect(publicUrl("/sign-in", request).toString()).toBe("http://0.0.0.0:3000/sign-in");
+});
diff --git a/apps/web/src/lib/public-url.ts b/apps/web/src/lib/public-url.ts
new file mode 100644
index 0000000..772c797
--- /dev/null
+++ b/apps/web/src/lib/public-url.ts
@@ -0,0 +1,10 @@
+// The server can see its own bind address (0.0.0.0 in the image) in
+// request.url. Redirects must point where users reach the app, which is
+// BETTER_AUTH_URL when it is set.
+export function publicUrl(path: string, request: { url: string }): URL {
+  const base = process.env.BETTER_AUTH_URL?.trim().replace(/\/+$/, "");
+  if (base) {
+    return new URL(base + path);
+  }
+  return new URL(path, request.url);
+}
