+
+test("a file over 2 MB is refused by name and nothing is sent", async () => {
+  const calls = stubApi(() => ({ status: 200, body: [] }));
+  renderDocuments();
+  await screen.findByText("No documents yet.");
+
+  fireEvent.change(screen.getByLabelText("Files"), {
+    target: { files: [sizedFile("big.pdf", 2_000_001)] },
+  });
+
+  expect(screen.getByRole("alert").textContent).toBe("big.pdf is larger than 2 MB.");
+  const upload = screen.getByRole("button", { name: "Upload documents" });
+  expect(upload.hasAttribute("disabled")).toBe(true);
+  fireEvent.click(upload);
+  expect(calls.some((call) => call.method === "POST")).toBe(false);
+});
+
+test("exactly 20 files and a file of exactly 2,000,000 bytes are allowed", async () => {
+  stubApi(() => ({ status: 200, body: [] }));
+  renderDocuments();
+  await screen.findByText("No documents yet.");
+
+  const files = [...manyFiles(19), sizedFile("edge.pdf", 2_000_000)];
+  fireEvent.change(screen.getByLabelText("Files"), { target: { files } });
+
+  expect(screen.queryByRole("alert")).toBeNull();
+  const upload = screen.getByRole("button", { name: "Upload documents" });
+  expect(upload.hasAttribute("disabled")).toBe(false);
+});
+
+test("choosing a valid set after a refused one clears the alert", async () => {
+  stubApi(() => ({ status: 200, body: [] }));
+  renderDocuments();
+  await screen.findByText("No documents yet.");
+  const input = screen.getByLabelText("Files");
+
+  fireEvent.change(input, { target: { files: manyFiles(21) } });
+  expect(screen.getByRole("alert").textContent).toBe("Choose at most 20 files.");
+
+  fireEvent.change(input, { target: { files: manyFiles(2) } });
+  expect(screen.queryByRole("alert")).toBeNull();
+  const upload = screen.getByRole("button", { name: "Upload documents" });
+  expect(upload.hasAttribute("disabled")).toBe(false);
+});
