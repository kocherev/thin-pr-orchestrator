+def test_a_session_proposes_at_most_three_handoffs(
+    http: TestClient, linear: FakeLinear, room: str, as_user: Headers, rows
+) -> None:
+    connect(http, as_user())
+
+    for _ in range(3):
+        assert propose(http, room).status_code == 201
+    fourth = propose(http, room)
+
+    assert fourth.status_code == 429
+    assert fourth.json() == {"detail": "too many handoffs proposed in this session"}
+    assert len(rows("escalations")) == 3
+    audit = [r for r in rows("audit_log") if r["action"] == "escalation.propose"]
+    assert len(audit) == 3
+
+
+def test_a_dismissed_handoff_keeps_its_slot_and_other_rooms_are_apart(
+    http: TestClient,
+    linear: FakeLinear,
+    room: str,
+    as_user: Headers,
+    sync_engine: Engine,
+    rows,
+) -> None:
+    connect(http, as_user())
+    first = propose(http, room).json()
+    http.post(f"/escalations/{first['id']}/dismiss", headers=as_user())
+    propose(http, room)
+    propose(http, room)
+
+    assert propose(http, room).status_code == 429
+    other = f"kb-{uuid4()}"
+    with Session(sync_engine) as db:
+        session = db.query(LiveSessionRow).filter_by(room=room).one()
+        db.add(
+            LiveSessionRow(
+                org_id="org-a",
+                product_id=session.product_id,
+                room=other,
+                user_id="user-a",
+            )
+        )
+        db.commit()
+    assert propose(http, other).status_code == 201
+    assert len(rows("escalations")) == 4
+
