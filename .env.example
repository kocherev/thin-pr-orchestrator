# Placeholders only. Copy to .env for local use. Never commit a real token.
GITHUB_TOKEN=replace-me
GITHUB_REPOSITORY=owner/name

# live, record or replay. replay is the default. Set live or record only when ANTHROPIC_API_KEY is a real key.
THIN_PR_MODEL=replay
ANTHROPIC_API_KEY=
# The cassette that record writes and replay reads.
THIN_PR_CASSETTE=
# Live and record calls stop before a request that could pass this many USD. Defaults to 25.
THIN_PR_SPEND_LIMIT_USD=

# Set a path to write the OTLP JSON trace. pnpm trace prints the JSON to stdout when this is empty.
THIN_PR_TRACE_PATH=

# Set a path to write the RunRecord JSON for a labeled-issue run. Nothing is written when this is empty.
THIN_PR_RECORD_PATH=
